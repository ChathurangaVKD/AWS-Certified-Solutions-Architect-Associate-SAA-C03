@inherits LayoutComponentBase

<div class="shell">
    <header class="topbar">
        <a class="brand" href="/" aria-label="Trilha C#/.NET Sênior - início">
            <span class="brand-mark" aria-hidden="true">C#</span>
            <span><strong>Trilha Sênior</strong><small>C# / .NET</small></span>
        </a>
        <nav aria-label="Navegação principal">
            <a href="/">Roadmap</a>
            <a href="/#capstone">Capstone</a>
        </nav>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="site-footer">
        <span>Aprenda com intenção. Entregue com qualidade.</span>
        <span>.NET 8 LTS · sem dependências externas</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
